# Generated by CMake

set(PHYSICA_PROFILE @PHYSICA_PROFILE@)
set(PHYSICA_GUI @PHYSICA_GUI@)
set(PHYSICA_MKL @PHYSICA_MKL@)
set(PHYSICA_MPI @PHYSICA_MPI@)
set(PHYSICA_HDF5 @PHYSICA_HDF5@)
set(PHYSICA_CUDA @PHYSICA_CUDA@)
set(PHYSICA_PYTHON @PHYSICA_PYTHON@)
set(CMAKE_DISABLE_PRECOMPILE_HEADERS @CMAKE_DISABLE_PRECOMPILE_HEADERS@)
set(CMAKE_CUDA_ARCHITECTURES @CMAKE_CUDA_ARCHITECTURES@)

list(APPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})
include(PhysicaConfigImpl)

get_filename_component(Physica_ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(Physica_INCLUDE_DIR "${Physica_ROOT_DIR}/include")
set(Physica_LIBRARY_DIR "${Physica_ROOT_DIR}/lib")

if (EXISTS "${Physica_INCLUDE_DIR}/Physica/Config.h")
    set(Physica_FOUND TRUE)
else()
    set(Physica_FOUND FALSE)
    return()
endif()

list(APPEND PhysicaModules Core Gui Logger)
foreach (module IN LISTS PhysicaModules)
    set(Physica${module}_LIBRARIES "${Physica_LIBRARY_DIR}/libPhysica${module}.so")
    if (EXISTS ${Physica${module}_LIBRARIES})
        set(Physica${module}_FOUND TRUE)
        list(APPEND Physica_LIBRARIES ${Physica${module}_LIBRARIES})
    else()
        set(Physica${module}_FOUND FALSE)
        message(WARNING "Physica${module} not found")
        unset(Physica${module}_LIBRARIES)
    endif()
endforeach()

include(PhysicaTargets)
