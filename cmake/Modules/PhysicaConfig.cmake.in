@PACKAGE_INIT@

set(PHYSICA_ARCH @PHYSICA_ARCH@)
set(PHYSICA_GUI @PHYSICA_GUI@)
set(PHYSICA_MKL @PHYSICA_MKL@)
set(PHYSICA_MPI @PHYSICA_MPI@)
set(PHYSICA_HDF5 @PHYSICA_HDF5@)
set(PHYSICA_CUDA @PHYSICA_CUDA@)
set(PHYSICA_MIMALLOC @PHYSICA_MIMALLOC@)
set(PHYSICA_LLVM @PHYSICA_LLVM@)
if(@PHYSICA_CUDA@)
    set(CMAKE_CUDA_ARCHITECTURES @CMAKE_CUDA_ARCHITECTURES@)
endif()

if(NOT EXISTS "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/Physica/Config.h")
    set(Physica_FOUND FALSE)
    set(Physica_NOT_FOUND_MESSAGE "Config.h not found")
    return()
endif()

set(_physica_components ${Physica_FIND_COMPONENTS})
if(NOT _physica_components)
    set(_physica_components Core)
    set(_physica_default TRUE)
endif()

set(_physica_module_path "${CMAKE_MODULE_PATH}")
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/modules")
include("${CMAKE_CURRENT_LIST_DIR}/modules/PhysicaConfigImpl.cmake")
list(REMOVE_ITEM CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/modules")

foreach(_physica_component IN LISTS _physica_components)
    set(_physica_targets "${CMAKE_CURRENT_LIST_DIR}/Physica${_physica_component}Targets.cmake")
    if(EXISTS "${_physica_targets}")
        include("${_physica_targets}")
        set(Physica_${_physica_component}_FOUND TRUE)
    else()
        set(Physica_${_physica_component}_FOUND FALSE)
        set(Physica_NOT_FOUND_MESSAGE "${_physica_component} component not found")
        if(_physica_default OR Physica_FIND_REQUIRED_${_physica_component})
            set(Physica_FOUND FALSE)
        endif()
    endif()
endforeach()

check_required_components(Physica)
